# ===========================================
# BEVARS EXPORTERS - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in the values

# -----------------
# DATABASE (Neon)
# -----------------
# Get this from: https://console.neon.tech
DATABASE_URL=postgresql://username:password@ep-xxxxx.us-east-2.aws.neon.tech/bevars?sslmode=require

# -----------------
# AUTHENTICATION
# -----------------
JWT_SECRET=your-super-secret-jwt-key-change-this
ADMIN_ACCESS_KEY=your-admin-access-key

# -----------------
# SERVER
# -----------------
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://bevars.com

# -----------------
# CLOUDINARY (File Uploads)
# -----------------
# Get these from: https://console.cloudinary.com/settings/c-xxxxx/api-keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------
# EMAIL (Mailtrap)
# -----------------
# Get this from: https://mailtrap.io/sending/domains
MAILTRAP_API_TOKEN=your-mailtrap-api-token
EMAIL_FROM=noreply@bevars.com
ADMIN_EMAIL=admin@bevars.com

# -----------------
# PAYMENTS (Flutterwave)
# -----------------
# Get these from: https://dashboard.flutterwave.com/settings/apis
FLW_PUBLIC_KEY=FLWPUBK-xxxxx
FLW_SECRET_KEY=FLWSECK-xxxxx
FLW_ENCRYPTION_KEY=your-encryption-key
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_WEBHOOK_SECRET=your-webhook-secret

# -----------------
# REDIS (Optional - Upstash)
# -----------------
# Get this from: https://console.upstash.com
# Leave empty if not using Redis - app will work without it
REDIS_URL=

# -----------------
# BETTER AUTH (if using)
# -----------------
BETTER_AUTH_SECRET=your-better-auth-secret
BETTER_AUTH_URL=https://api.bevars.com
